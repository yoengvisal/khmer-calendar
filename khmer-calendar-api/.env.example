# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER@localhost:5432/khmer_calendar_dev
# At least 32 random characters: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-48-plus-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated allowlist of browser origins (admin dashboard)
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
LOG_FORMAT=pretty
TRUST_PROXY=false

# Used only by `npm run db:seed` (local/dev). Never set in production.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
