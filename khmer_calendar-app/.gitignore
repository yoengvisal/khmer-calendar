# ---- FVM -------------------------------------------------------------------
# The SDK pin lives in the repo-root .fvmrc (committed). Never commit the
# per-machine SDK symlink / version cache.
.fvm/flutter_sdk
.fvm/
!.fvmrc

# ---- Flutter / Dart ----------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
*.g.dart.tmp

# ---- IDE / OS --------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.DS_Store
.history
.swiftpm/

# ---- Android ---------------------------------------------------------------
android/.gradle/
android/.kotlin/
android/local.properties
android/captures/
android/app/debug/
android/app/profile/
android/app/release/
android/gradlew
android/gradlew.bat
android/gradle/wrapper/gradle-wrapper.jar
android/key.properties
**/*.keystore
**/*.jks
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java

# ---- iOS (more rules in ios/.gitignore) ------------------------------------
ios/build/
